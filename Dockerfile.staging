FROM node:22-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
# 构建工具及平台原生绑定必须安装，避免 npm 环境配置省略可选依赖。
RUN npm ci --include=dev --include=optional --no-audit --no-fund \
    && node --input-type=module -e "await import('rolldown')"
COPY . .
ARG VITE_API_BASE_URL
ARG RELEASE_ID
ARG BUILD_COMMIT
ARG BUILD_TIMESTAMP
RUN if [ -z "${VITE_API_BASE_URL:-}" ]; then unset VITE_API_BASE_URL; fi; \
    npm run build:staging

FROM nginx:1.29-alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY --from=build /app/.deploy/default.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/health || exit 1
